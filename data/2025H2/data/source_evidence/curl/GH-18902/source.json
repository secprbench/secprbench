  "candidate_status": "targeted_public_report_pending_security_and_construction_review",
  "security_screen": {
    "status": "pending",
    "preliminary_impact": "revocation_status_not_rechecked_for_resumed_tls_session",
    "untrusted_input_boundary": "TLS peer controls handshake, session resumption, certificate and stapled OCSP response; the client has explicitly enabled CURLOPT_SSL_VERIFYSTATUS",
    "untrusted_input_boundary_proven": true,
    "oracle": "Two requests on one easy handle with CURLOPT_FORBID_REUSE: establish a good OCSP-stapled TLS session, then change the same test server's stapled response to revoked or missing before request two. Buggy code resumes and skips verifystatus; fixed code forces a full handshake and should reject the second response.",
    "qualification": "The prior 2023 issue considered skipping a second OCSP check normal for session resumption. The 2025 fix adopts stricter client-option semantics. No committed or tested two-response security reproducer exists yet; a same-input end-to-end oracle is required before admission.",
    "earliest_fix_review_required": true
  },
