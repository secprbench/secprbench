    "findings": [
      {
        "rule_id": "sec-intoverflow-001",
        "title": "Integer overflow in fts3auxGrowStatArray via unbounded iCol from corrupt doclist",
        "message": "In fts3auxNextMethod(), when processing a doclist entry in state 3 (column number), the column value `iCol` read from the database is only checked for a lower bound (`iCol < 1`) but has no upper bound guard. An attacker-controlled corrupt FTS3 database can store a very large column number (e.g. 0x10000000). This value is passed to fts3auxGrowStatArray(pCsr, iCol+2). Inside that function, the allocation size is computed as `sizeof(struct Fts3auxColstats) * nSize` using plain C arithmetic. On 32-bit platforms where size_t is 32 bits, this multiplication overflows (e.g. 16 * 268435458 = 4294967328 wraps to 32 on 32-bit), causing sqlite3_realloc64 to return a far too small buffer. The subsequent write `pCsr->aStat[iCol+1].nDoc++` then writes far beyond the allocated region, constituting a heap buffer overflow.",
        "location": {
          "file": "ext/fts3/fts3_aux.c",
          "start_line": 340,
          "end_line": 348,
          "start_column": null,
          "end_column": null,
          "function": "fts3auxNextMethod",
          "snippet": "        default: assert( eState==3 );\n          iCol = (int)v;\n          if( iCol<1 ){\n            rc = SQLITE_CORRUPT_VTAB;\n            break;\n          }\n          if( fts3auxGrowStatArray(pCsr, iCol+2) ) return SQLITE_NOMEM;\n          pCsr->aStat[iCol+1].nDoc++;",
          "snippet_hash": null,
          "description": null
        },
        "related_locations": [
          {
            "file": "ext/fts3/fts3_aux.c",
            "start_line": 248,
            "end_line": null,
            "start_column": null,
            "end_column": null,
            "function": "fts3auxGrowStatArray",
            "snippet": null,
            "snippet_hash": null,
